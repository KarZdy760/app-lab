pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    triggers {
	pollSCM('* * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t app-lab:ci-$BUILD_NUMBER .'
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker run --rm --entrypoint python \
                      app-lab:ci-$BUILD_NUMBER \
                      -c 'from app import app; response = app.test_client().get("/live"); assert response.status_code == 200, response.status_code; assert response.json["status"] == "alive", response.json; print("PASS: /live")'
                '''
            }
	}
        stage('Publish') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ghcr-app-lab',
                        usernameVariable: 'GHCR_USER',
                        passwordVariable: 'GHCR_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        export DOCKER_CONFIG="$(mktemp -d)"
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                        printf '%s' "$GHCR_TOKEN" |
                          docker login ghcr.io \
                            -u "$GHCR_USER" --password-stdin

                        docker tag app-lab:ci-$BUILD_NUMBER \
                          ghcr.io/karzdy760/app-lab:ci-$BUILD_NUMBER

                        docker push \
                          ghcr.io/karzdy760/app-lab:ci-$BUILD_NUMBER
                    '''
                }
            }
        }
    }
}

